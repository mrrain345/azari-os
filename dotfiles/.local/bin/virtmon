#!/bin/sh
ACTION=$1
MONITOR=DP-3

function monitor_enable() {
  hyprctl keyword monitor "$MONITOR, 1920x1080@60, 3840x0, 1" > /dev/null
  hyprctl keyword workspace "999, monitor:$MONITOR, default:true, rounding:false, decorate:false, gapsin:0, gapsout:0, border:false" > /dev/null
  hyprctl keyword windowrule "opacity 1.0, workspace:999" > /dev/null
  hyprctl keyword windowrule "noanim, workspace:999" > /dev/null
  hyprctl keyword windowrule "nodim, workspace:999" > /dev/null
}

function monitor_disable() {
  hyprctl keyword monitor "$MONITOR, disable" > /dev/null
}

if [ "$ACTION" = "enable" ]; then
  monitor_enable
elif [ "$ACTION" = "disable" ]; then
  monitor_disable
else
  echo "Usage: $(basename $0) {enable|disable}"
  exit 1
fi